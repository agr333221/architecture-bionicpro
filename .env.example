# Секреты учебного стенда. Скопируйте в .env и при необходимости поменяйте.
# Файл .env в git не попадает.

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=change-me

# --- bionicpro-auth ---
BIONICPRO_AUTH_CLIENT_SECRET=change-me
# 32 случайных байта в base64 (ключ AES-256-GCM для refresh_token): openssl rand -base64 32
TOKEN_ENC_KEY=Q2hhbmdlTWVDaGFuZ2VNZUNoYW5nZU1lQ2hhbmdlTWU=
REDIS_PASSWORD=change-me

# --- LDAP ---
LDAP_ADMIN_PASSWORD=admin

# --- Yandex ID (https://oauth.yandex.ru, redirect URI:
#     http://localhost:8080/realms/reports-realm/broker/yandex/endpoint) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- CRM и телеметрия ---
CRM_DB_USER=crm_user
CRM_DB_PASSWORD=change-me
TELEMETRY_DB_USER=telemetry_user
TELEMETRY_DB_PASSWORD=change-me

# --- ClickHouse ---
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=change-me
CLICKHOUSE_AIRFLOW_PASSWORD=change-me
CLICKHOUSE_REPORTS_API_PASSWORD=change-me

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me

# --- Minio / reports ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
REPORT_USER_KEY_SECRET=change-me

# --- Режимы ---
# Источник CRM для DAG: airflow (задание 2) или cdc (задание 4)
CRM_SOURCE=cdc
# Витрина, которую читает reports-api: airflow (report_daily) или cdc (report_daily_cdc)
REPORT_SOURCE=cdc
